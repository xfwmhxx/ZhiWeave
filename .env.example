# Copy to .env for Linux, WSL2 or native Windows overrides.
# Never commit the real .env file.
STUDYRAG_ENVIRONMENT=development
STUDYRAG_LOG_LEVEL=INFO
STUDYRAG_CORS_ORIGINS=["http://localhost:5173"]

# Portable TCP configuration. Create this database/user before starting the API.
STUDYRAG_DATABASE_URL=postgresql+asyncpg://zhiweave:change-this-password@127.0.0.1:5432/zhiweave
STUDYRAG_REDIS_URL=redis://127.0.0.1:6379/0
STUDYRAG_CELERY_BROKER_URL=redis://127.0.0.1:6379/1
STUDYRAG_CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
STUDYRAG_QDRANT_URL=http://127.0.0.1:6333

STUDYRAG_EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
STUDYRAG_EMBEDDING_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
STUDYRAG_EMBEDDING_DIMENSION=384
STUDYRAG_EMBEDDING_QUERY_PREFIX="query: "
STUDYRAG_EMBEDDING_PASSAGE_PREFIX="passage: "
STUDYRAG_EMBEDDING_DEVICE=auto
STUDYRAG_EMBEDDING_BATCH_SIZE=32

STUDYRAG_CHUNK_SIZE=480
STUDYRAG_CHUNK_OVERLAP=80
STUDYRAG_CHUNK_STRATEGY=character
STUDYRAG_CRAWLER_USER_AGENT="ZhiWeave/0.1 (+local educational RAG project)"
STUDYRAG_CRAWLER_DEFAULT_MAX_PAGES=40
STUDYRAG_CRAWLER_DELAY_SECONDS=0.6
STUDYRAG_CRAWLER_MAX_RESPONSE_BYTES=2000000
# Only for a trusted local TUN proxy that resolves public hosts to fake IPs.
STUDYRAG_CRAWLER_TRUSTED_DNS_PROXY_CIDRS=[]

# Local development can remain empty. Hosted environments must set a long random key.
STUDYRAG_API_KEY=
STUDYRAG_DEFAULT_WORKSPACE_ID=local
STUDYRAG_WORKSPACE_API_KEYS={}
STUDYRAG_RATE_LIMIT_PER_MINUTE=120
STUDYRAG_MAX_ACTIVE_TASKS_PER_KNOWLEDGE_BASE=3
STUDYRAG_MAX_DOCUMENTS_PER_KNOWLEDGE_BASE=10000
STUDYRAG_MAX_UPLOAD_BYTES=20000000
STUDYRAG_EXPORT_SPOOL_BYTES=8000000
STUDYRAG_RETRIEVAL_CANDIDATE_LIMIT=100
STUDYRAG_RERANKER_MODEL_NAME=
STUDYRAG_METRICS_ENABLED=true
